#!/bin/bash
out=""; xml=0; prev=""
for a in "$@"; do [[ "$prev" == "/output" ]] && out="$a"; [[ "$a" == "/xml" ]] && xml=1; prev="$a"; done
if [[ $xml == 1 ]]; then cat > "$out" <<'X'
<?xml version="1.0" encoding="utf-8"?>
<BatteryReport xmlns="http://schemas.microsoft.com/battery/2012">
 <ReportInformation><LocalScanTime>2026-11-15T19:00:00</LocalScanTime></ReportInformation>
 <Batteries><Battery><Id>01AV489</Id><Manufacturer>SMP</Manufacturer><SerialNumber>1234</SerialNumber><ManufactureDate></ManufactureDate><Chemistry>LiP</Chemistry><DesignCapacity>57000</DesignCapacity><FullChargeCapacity>45000</FullChargeCapacity><CycleCount>412</CycleCount></Battery></Batteries>
 <History>
  <HistoryEntry LocalStartDate="2025-11-01T00:00:00" LocalEndDate="2025-11-08T00:00:00" DesignCapacity="57000" FullChargeCapacity="40100" CycleCount="301"/>
  <HistoryEntry LocalStartDate="2026-02-01T00:00:00" LocalEndDate="2026-02-08T00:00:00" DesignCapacity="57000" FullChargeCapacity="38800" CycleCount="340"/>
  <HistoryEntry LocalStartDate="2026-05-01T00:00:00" LocalEndDate="2026-05-08T00:00:00" DesignCapacity="57000" FullChargeCapacity="37900" CycleCount="372"/>
  <HistoryEntry LocalStartDate="2026-08-01T00:00:00" LocalEndDate="2026-08-08T00:00:00" DesignCapacity="57000" FullChargeCapacity="46000" CycleCount="398"/>
  <HistoryEntry LocalStartDate="2026-11-01T00:00:00" LocalEndDate="2026-11-08T00:00:00" DesignCapacity="57000" FullChargeCapacity="45000" CycleCount="412"/>
 </History>
</BatteryReport>
X
else echo "<html><body>Windows-Akkubericht (Simulation)</body></html>" > "$out"; fi
