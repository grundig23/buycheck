#!/bin/bash
if [[ "$*" == *"interfaces"* ]]; then printf 'There is 1 interface on the system:\n\n    Name                   : WLAN\n    Description            : Intel(R) Wi-Fi 6 AX201 160MHz\n    State                  : connected\n    SSID                   : FRITZ!Box 7590\n    Signal                 : 87%%\n'; 
else printf 'Interface name : WLAN\nThere are 3 networks currently visible.\n\nSSID 1 : FRITZ!Box 7590\n    Network type            : Infrastructure\n    Signal             : 87%%\nSSID 2 : Vodafone-1234\n    Signal             : 41%%\nSSID 3 : \n    Signal             : 22%%\n'; fi
